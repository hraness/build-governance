{
  "name": "@hraness/build-governance",
  "version": "0.2.0",
  "description": "Build checks shared by Hraness repositories: Effect architecture rules, package inventory, and a public copy lint.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/build-governance.git"
  },
  "homepage": "https://github.com/hraness/build-governance",
  "bin": {
    "hraness-copy-lint": "./dist/public-copy-cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./effect-architecture": {
      "types": "./src/effect-architecture.ts",
      "import": "./dist/effect-architecture.js"
    },
    "./portfolio-inventory": {
      "types": "./src/portfolio-inventory.ts",
      "import": "./dist/portfolio-inventory.js"
    },
    "./public-copy": {
      "types": "./src/public-copy.ts",
      "import": "./dist/public-copy.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/effect-architecture.ts ./src/portfolio-inventory.ts ./src/public-copy.ts ./src/public-copy-cli.ts --outdir ./dist --root ./src --target bun --format esm --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "check:copy": "bun ./src/public-copy-cli.ts",
    "check": "bun run typecheck && bun run test && bun run check:copy"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "effect": "3.22.1",
    "fast-check": "^4.8.0",
    "typescript": "^6.0.3"
  }
}
