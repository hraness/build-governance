{
  "name": "@hraness/build-governance",
  "version": "0.1.0",
  "description": "Shared Hraness build-governance scripts and canonical inventory logic.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/build-governance.git"
  },
  "homepage": "https://github.com/hraness/build-governance",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./effect-architecture": {
      "types": "./src/effect-architecture.ts",
      "import": "./dist/effect-architecture.js"
    },
    "./portfolio-inventory": {
      "types": "./src/portfolio-inventory.ts",
      "import": "./dist/portfolio-inventory.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/effect-architecture.ts ./src/portfolio-inventory.ts --outdir ./dist --root ./src --target bun --format esm --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "check": "bun run typecheck && bun run test"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "effect": "3.22.1",
    "fast-check": "^4.8.0",
    "typescript": "^6.0.3"
  }
}
